# Chalk Node Backend Security & Firebase Admin Configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS & Socket.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# LiveKit WebRTC SFU Server Configuration
# Cloud project (wss://<project>.livekit.cloud) or local livekit-server (ws://127.0.0.1:7880)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Firebase Admin SDK Configuration (for cryptographic ID token verification & Firestore sync)
FIREBASE_PROJECT_ID=
# Either provide path to service account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=
# Or inline JSON string of the service account key:
FIREBASE_SERVICE_ACCOUNT_JSON=
